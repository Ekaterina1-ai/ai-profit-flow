# Never put real secrets in VITE_* — they are baked into the public JS bundle.
# Formspree endpoint is public by design.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xdeaervd

# Server-only (local Node server.js) — do NOT prefix with VITE_
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
PORT=3001
